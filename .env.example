# Required for production authentication
AUTH_SECRET=replace-with-a-long-random-secret
SELLER_PASSWORD=replace-with-a-seller-password
BUYER_PASSWORD=replace-with-a-buyer-password
ADMIN_PASSWORD=replace-with-an-admin-password

# Local prototype persistence. Use AGROBRIDGE_STORE_MODE=database for production.
AGROBRIDGE_DATA_FILE=./data/agrobridge.json

# Production persistence. This can be a relative or absolute SQLite file path.
AGROBRIDGE_STORE_MODE=database
AGROBRIDGE_DATABASE_URL=./data/agrobridge.db
